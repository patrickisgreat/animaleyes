# Copy to .env. Never commit .env.

# Camera. Its IP comes from DHCP, so put {host} in the URL and give the camera's MAC; the
# app finds the current IP in the ARP table on every (re)connect. A literal IP also works.
# Find the MAC with: ip neigh   (TP-Link MACs here start a8:42:a1)
KASA_CAMERA_MAC=
# Newer Kasa cameras speak RTSP:
#   KASA_STREAM_URL=rtsp://user:pass@{host}:554/stream1
# Older Kasa cameras (KC120 etc.) use the HTTPS stream on :19443 with basic auth.
# Give the URL without credentials and set KASA_EMAIL / KASA_PASSWORD; the app derives
# the password the camera expects (base64 of the Kasa password).
#   KASA_STREAM_URL=https://{host}:19443/https/stream/mixed?video=h264&audio=g711&resolution=hd
KASA_STREAM_URL=
KASA_EMAIL=
KASA_PASSWORD=

ANTHROPIC_API_KEY=

# PetLibro account used by petlibro-cli (a second shared account avoids signing the phone out).
PETLIBRO_EMAIL=
PETLIBRO_PASSWORD=
PETLIBRO_SERIAL=

SLACK_WEBHOOK=

# Email + SMS alerts for anything going offline (camera lost, feed/close failed, no food left).
# Routine chatter stays in Slack/logs; only urgent alerts email/text, so the phone stays quiet.
# All values are real secrets/PII — set them in your .env (gitignored), never commit them here.
# Example (Gmail needs an App Password, not your login: https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com   SMTP_USER=you@example.com   SMTP_FROM=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where alerts go. Comma-separated email and/or carrier email-to-SMS gateway for a TEXT:
#   Verizon <number>@vtext.com · AT&T <number>@txt.att.net · T-Mobile <number>@tmomail.net
#   e.g. ALERT_TO=you@example.com,5551234567@vtext.com
ALERT_TO=

# Dashboard login (HTTP basic auth). Use a long random password: openssl rand -base64 24
DASH_USER=
DASH_PASSWORD=
# How the dashboard is reached from your phone, used in Slack links (no credentials in them).
DASH_PUBLIC_URL=https://grrr.example.com

TZ=America/Chicago
