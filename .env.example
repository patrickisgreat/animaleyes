# Copy to .env. Never commit .env.

# Camera. Newer Kasa cameras speak RTSP:
#   KASA_STREAM_URL=rtsp://user:pass@192.168.1.50:554/stream1
# Older Kasa cameras (KC120 etc.) use the HTTPS stream on :19443 with basic auth.
# Give the URL without credentials and set KASA_EMAIL / KASA_PASSWORD; the app derives
# the password the camera expects (base64 of sha256 of the Kasa password).
#   KASA_STREAM_URL=https://192.168.1.50:19443/https/stream/mixed?video=h264&audio=g711&resolution=hd
KASA_STREAM_URL=
KASA_EMAIL=
KASA_PASSWORD=

ANTHROPIC_API_KEY=

# PetLibro account used by petlibro-cli (a second shared account avoids signing the phone out).
PETLIBRO_EMAIL=
PETLIBRO_PASSWORD=
PETLIBRO_SERIAL=

SLACK_WEBHOOK=

# Any long random string. Every dashboard route needs ?token=<this>.
DASH_TOKEN=
# How the dashboard is reached from your phone, used in Slack links.
DASH_PUBLIC_URL=http://your-box.tailnet-name.ts.net:8080

TZ=America/Chicago
